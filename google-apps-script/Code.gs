entive</span></h1>\n      <p>Live % Leaderboard</p>\n    </div>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <h2>Galaxy Ultra Titans</h2>\n      <div class=\"legend\">\n        <span class=\"pill\"><span class=\"dot blue\"></span> Cut-in Met</span>\n        <span class=\"pill\"><span class=\"dot green\"></span> Target Reached</span>\n        <button id=\"refreshButton\">↻ Refresh</button>\n      </div>\n    </section>\n\n    <nav id=\"groups\" class=\"legend\" aria-label=\"Leaderboard groups\" style=\"margin-top:24px\"></nav><p id=\"syncStatus\" role=\"status\" style=\"text-align:center;color:#a3a3a3;font-size:13px\"></p>\n    <section id=\"podium\" class=\"podium\"></section>\n    <section id=\"rankList\" class=\"list\"></section>\n  </main>\n\n  <script>\n    const initialGroups = [{\"id\":\"group1\",\"name\":\"Galaxy Ultra Titans\",\"stores\":[{\"id\":100,\"name\":\"JB HIFI Malaga (Titan)\",\"cutIn\":186,\"target\":203,\"sales\":null},{\"id\":101,\"name\":\"JB Hifi Osborne Park (Titan)\",\"cutIn\":194,\"target\":211,\"sales\":null}]},{\"id\":\"group2\",\"name\":\"Group 2 — Large Volume\",\"stores\":[{\"id\":200,\"name\":\"JB HIFI Cannington\",\"cutIn\":147,\"target\":161,\"sales\":null},{\"id\":201,\"name\":\"JB HIFI Carousel\",\"cutIn\":127,\"target\":138,\"sales\":null},{\"id\":202,\"name\":\"JB HIFI Cockburn\",\"cutIn\":136,\"target\":149,\"sales\":null},{\"id\":203,\"name\":\"JB HIFI Joondalup\",\"cutIn\":155,\"target\":169,\"sales\":null},{\"id\":204,\"name\":\"JB HIFI Rockingham\",\"cutIn\":140,\"target\":152,\"sales\":null}]},{\"id\":\"group3\",\"name\":\"Group 3 — Medium Volume\",\"stores\":[{\"id\":300,\"name\":\"JB HIFI Armadale\",\"cutIn\":85,\"target\":92,\"sales\":null},{\"id\":301,\"name\":\"JB HIFI Belmont Forum\",\"cutIn\":106,\"target\":115,\"sales\":null},{\"id\":302,\"name\":\"JB HIFI Booragoon\",\"cutIn\":88,\"target\":96,\"sales\":null},{\"id\":303,\"name\":\"JB HIFI Bunbury\",\"cutIn\":105,\"target\":114,\"sales\":null},{\"id\":304,\"name\":\"JB HIFI Clarkson\",\"cutIn\":76,\"target\":83,\"sales\":null},{\"id\":305,\"name\":\"JB HIFI Forrest Chase\",\"cutIn\":117,\"target\":127,\"sales\":null},{\"id\":306,\"name\":\"JB HIFI Karrinyup\",\"cutIn\":85,\"target\":92,\"sales\":null},{\"id\":307,\"name\":\"JB HIFI Midland\",\"cutIn\":92,\"target\":101,\"sales\":null},{\"id\":308,\"name\":\"JB HIFI Midland Gate\",\"cutIn\":94,\"target\":102,\"sales\":null},{\"id\":309,\"name\":\"JB HIFI Myaree\",\"cutIn\":112,\"target\":122,\"sales\":null}]},{\"id\":\"group4\",\"name\":\"Group 4 — Small Volume\",\"stores\":[{\"id\":400,\"name\":\"JB HIFI ALBANY\",\"cutIn\":34,\"target\":37,\"sales\":null},{\"id\":401,\"name\":\"JB HIFI Claremont\",\"cutIn\":25,\"target\":28,\"sales\":null},{\"id\":402,\"name\":\"JB HIFI Home Joondalup\",\"cutIn\":62,\"target\":67,\"sales\":null},{\"id\":403,\"name\":\"JB HIFI Mandurah\",\"cutIn\":70,\"target\":77,\"sales\":null},{\"id\":404,\"name\":\"JB HIFI Mandurah Forum\",\"cutIn\":74,\"target\":80,\"sales\":null},{\"id\":405,\"name\":\"JB HiFi Perth International Airport\",\"cutIn\":19,\"target\":20,\"sales\":null},{\"id\":406,\"name\":\"JB HIFI Whitfords\",\"cutIn\":63,\"target\":68,\"sales\":null}]}];\n    let groups = initialGroups, activeGroup = 'group1', data = [];\n    const podiumEl = document.getElementById('podium');\n    const rankListEl = document.getElementById('rankList');\n    const statusEl = document.getElementById('syncStatus');\n    let endpoint = '', loading = false;\n    const escapeHtml = value => String(value).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n    const percent = item => item.target ? (item.sales / item.target) * 100 : 0;\n    const statusColor = item => item.sales >= item.target ? '#4ade80' : item.sales >= item.cutIn ? '#60a5fa' : '#d4d4d8';\n\n    function sortedData() {\n      return [...data].sort((a,b) => {\n        const diff = percent(b) - percent(a);\n        return diff !== 0 ? diff : b.sales - a.sales;\n      });\n    }\n\n    function podiumCard(item, place) {\n      const classes = ['first','second','third'];\n      const icons = ['🏆','🥈','🥉'];\n      return `\n        <article class=\"podium-card ${classes[place-1]}\">\n          <div class=\"podium-icon\">${icons[place-1]}</div>\n          <div class=\"store-name\">${escapeHtml(item.name)}</div>\n          <div class=\"percent\" style=\"color:${statusColor(item)}\">${percent(item).toFixed(1)}%</div>\n          <div class=\"units\">${item.sales} / ${item.target} Units</div>\n          <div class=\"plinth\">${place}</div>\n        </article>`;\n    }\n\n    function progress(item) {\n      const salesPct = Math.min(percent(item),100);\n      const cutPct = Math.min((item.cutIn/item.target)*100,100);\n      const fillColor = item.sales >= item.target ? '#22c55e' : item.sales >= item.cutIn ? '#3b82f6' : '#737373';\n      return `\n        <div class=\"progress\">\n          <div class=\"progress-meta\"><span>Sales: ${item.sales}</span><strong style=\"color:${statusColor(item)}\">${percent(item).toFixed(1)}%</strong></div>\n          <div class=\"track\">\n            <div class=\"fill\" style=\"width:${salesPct}%;background:${fillColor}\"></div>\n            <div class=\"marker\" style=\"left:${cutPct}%\" title=\"Cut-in: ${item.cutIn}\"></div>\n          </div>\n          <div class=\"labels\">\n            <span>0</span>\n            <span class=\"cut-label\" style=\"left:${cutPct}%\">Cut-in (${item.cutIn})</span>\n            <span>Target (${item.target})</span>\n          </div>\n        </div>`;\n    }\n\n\n    function render() {\n      const group = groups.find(g => g.id === activeGroup) || groups[0];\n      data = group.stores.filter(s => s.sales !== null);\n      document.querySelector('.hero h2').textContent = group.name;\n      document.getElementById('groups').replaceChildren(...groups.map(g => {\n        const b = document.createElement('button');\n        b.textContent = g.name;\n        b.setAttribute('aria-pressed', String(g.id === group.id));\n        b.style.background = g.id === group.id ? '#2563eb' : '#262626';\n        b.onclick = () => { activeGroup = g.id; render(); };\n        return b;\n      }));\n      const sorted = sortedData();\n      podiumEl.innerHTML = sorted.slice(0,3).map((item,index) => podiumCard(item,index+1)).join('');\n      const ranked = sorted.slice(3).map((item,index) => '<div class=\"row\"><div class=\"rank\">#'+(index+4)+'</div><div class=\"row-name\">'+escapeHtml(item.name)+'</div>'+progress(item)+'</div>').join('');\n      const pending = group.stores.filter(s => s.sales === null).map(item => '<div class=\"row\"><div class=\"rank\">—</div><div class=\"row-name\">'+escapeHtml(item.name)+'</div><div class=\"progress\">Awaiting sales · Cut-in '+item.cutIn+' · Target '+item.target+'</div></div>').join('');\n      rankListEl.innerHTML = ranked + pending;\n      rankListEl.style.display = ranked || pending ? 'block' : 'none';\n    }\n    function validate(payload) {\n      if (!payload || !Array.isArray(payload.groups) || !payload.groups.length) throw new Error('Invalid response');\n      const ids = new Set();\n      for (const g of payload.groups) {\n        if (typeof g.id !== 'string' || ids.has(g.id) || typeof g.name !== 'string' || !Array.isArray(g.stores)) throw new Error('Invalid groups');\n        ids.add(g.id);\n        for (const s of g.stores) {\n          if (typeof s.name !== 'string' || !Number.isFinite(s.target) || s.target <= 0 || !Number.isFinite(s.cutIn) || s.cutIn < 0 || (s.sales !== null && (!Number.isInteger(s.sales) || s.sales < 0))) throw new Error('Invalid sales');\n        }\n      }\n      return payload;\n    }\n    function requestData() {\n      if (window.google && google.script && google.script.run) {\n        return new Promise((resolve,reject) => google.script.run.withSuccessHandler(resolve).withFailureHandler(reject).getLeaderboard());\n      }\n      return new Promise((resolve,reject) => {\n        const name = 'titansCallback_' + Date.now();\n        const script = document.createElement('script');\n        const timer = setTimeout(() => finish(new Error('Request timed out')), 20000);\n        function finish(error,payload) {\n          clearTimeout(timer); script.remove(); delete window[name];\n          error ? reject(error) : resolve(payload);\n        }\n        window[name] = payload => finish(null,payload);\n        script.onerror = () => finish(new Error('Connection failed'));\n        const url = new URL(endpoint);\n        if (url.origin !== 'https://script.google.com' || !/^\\/macros\\/s\\/[\\w-]+\\/exec$/.test(url.pathname)) { finish(new Error('Invalid endpoint')); return; }\n        url.searchParams.set('callback',name); url.searchParams.set('_',String(Date.now()));\n        script.src = url.href; document.head.appendChild(script);\n      });\n    }\n    async function refresh() {\n      if (loading) return;\n      if (!endpoint && !(window.google && google.script && google.script.run)) {\n        statusEl.textContent = 'Setup pending — Google Sheets syncing is not active yet. Sales have not been loaded.';\n        return;\n      }\n      loading = true;\n      const button = document.getElementById('refreshButton');\n      button.disabled = true;\n      statusEl.textContent = 'Checking Google Sheets…';\n      try {\n        const payload = validate(await requestData());\n        groups = payload.groups; render();\n        statusEl.textContent = 'Live from Google Sheets · Checked ' + new Date().toLocaleTimeString() + ' · Refreshes every 60 seconds';\n      } catch (error) {\n        statusEl.textContent = 'Could not refresh Google Sheets. Displayed figures may be out of date. Try Refresh.';\n      } finally { loading = false; button.disabled = false; }\n    }\n    async function start() {\n      render();\n      try { const config = await fetch('./config.json', {cache:'no-store'}).then(r => {if (!r.ok) throw new Error(); return r.json();}); endpoint = config.appsScriptUrl || ''; } catch (_) {}\n      await refresh();\n      setInterval(() => { if (!document.hidden) refresh(); },60000);\n      document.addEventListener('visibilitychange',() => {if (!document.hidden) refresh();});\n    }\n    document.getElementById('refreshButton').onclick = refresh;\n    start();\n\n  </script>\n</body>\n</html>\n";
