
const SPREADSHEET_ID = '1x22bFLwRQtRXQJP1iPcG9z_B_uA5FNkaEfwcAk5t-Bk';
function getLeaderboard() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const salesSheet = ss.getSheetByName('JBHIFI Live Sales');
  const groupSheet = ss.getSheetByName('JBHIFI Groups');
  if (!salesSheet || !groupSheet) throw new Error('Required leaderboard tabs are missing.');
  const key = v => String(v).trim().toLowerCase();
  const sales = new Map(salesSheet.getRange(2,1,Math.max(1,salesSheet.getLastRow()-1),2).getValues().filter(r=>r[0]).map(r=>{
    const n = r[1] === '' ? null : Number(r[1]);
    if (n !== null && (!Number.isInteger(n) || n < 0)) throw new Error('Sales must be non-negative whole numbers.');
    return [key(r[0]),n];
  }));
  const rows = groupSheet.getRange('A4:L13').getValues();
  const names = ['Galaxy Ultra Titans','Group 2 — Large Volume','Group 3 — Medium Volume','Group 4 — Small Volume'];
  const groups = names.map((name,i) => {
    const col = 9-i*3;
    return {id:'group'+(i+1),name,stores:rows.filter(r=>r[col]).map((r,j)=>{
      const target = Number(r[col+2]), cutIn = Number(r[col+1]);
      if (!Number.isFinite(target) || target <= 0 || !Number.isFinite(cutIn) || cutIn < 0) throw new Error('Invalid target.');
      return {id:(i+1)*100+j,name:String(r[col]),cutIn,target,sales:sales.has(key(r[col]))?sales.get(key(r[col])):null};
    })};
  });
  return {groups,checkedAt:new Date().toISOString()};
}
function doGet(e) {
  const callback = e && e.parameter && e.parameter.callback;
  if (!callback) return HtmlService.createHtmlOutput(PAGE_HTML).setTitle('Samsung × JB Hi-Fi Black Friday Leaderboards');
  if (!/^titansCallback_[0-9]+$/.test(callback)) return ContentService.createTextOutput('Invalid callback');
  let payload;
  try { payload = getLeaderboard(); } catch (_) { payload = {error:'Leaderboard data is unavailable.'}; }
  return ContentService.createTextOutput(callback+'('+JSON.stringify(payload)+');').setMimeType(ContentService.MimeType.JAVASCRIPT);
}
